{
  "name": "aureon-hub",
  "productName": "Aureon Hub",
  "version": "0.1.0",
  "description": "Aureon Hub — widgets, notch e transmissão de tela",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "app": "electron .",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters && node scripts/lint-legacy.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.cjs",
    "test:e2e": "node tests/e2e/share-e2e.cjs",
    "test:electron": "node tests/e2e/electron-smoke.cjs",
    "icon": "python3 scripts/make-icon.py build/logo-source.png",
    "dist:win": "npm run build && electron-builder --win nsis",
    "server": "node server/index.mjs",
    "test:turn": "node tests/e2e/share-turn-e2e.cjs"
  },
  "build": {
    "appId": "com.aureon.hub",
    "productName": "Aureon Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aureon Hub",
      "artifactName": "AureonHub-Setup-${version}.${ext}",
      "uninstallDisplayName": "Aureon Hub",
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "Aureon Hub",
        "schemes": [
          "aureon"
        ]
      }
    ],
    "publish": null
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.10.2",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "author": "Aureon Hub"
}
