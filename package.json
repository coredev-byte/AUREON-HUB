{
  "name": "aureon-hub",
  "productName": "Aureon Hub",
  "version": "0.7.1",
  "description": "Aureon Hub — widgets, notch e transmissão de tela",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "app": "electron .",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters && node scripts/lint-legacy.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.cjs",
    "test:e2e": "node tests/e2e/share-e2e.cjs",
    "test:electron": "node tests/e2e/electron-smoke.cjs",
    "icon": "python3 scripts/make-icon.py build/logo-source.png",
    "dist:win": "npm run build && electron-builder --win nsis",
    "server": "node server/index.mjs",
    "test:turn": "node tests/e2e/share-turn-e2e.cjs",
    "test:click": "node tests/e2e/electron-notch-click.cjs"
  },
  "build": {
    "appId": "com.aureon.hub",
    "productName": "Aureon Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aureon Hub",
      "artifactName": "AureonHub-Setup-${version}.${ext}",
      "uninstallDisplayName": "Aureon Hub",
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "Aureon Hub",
        "schemes": [
          "aureon"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "coredev-byte",
        "repo": "AUREON-HUB",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/major-mono-display": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.10.2",
    "electron-builder": "^26.18.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "author": "Aureon Hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/coredev-byte/AUREON-HUB.git"
  }
}
